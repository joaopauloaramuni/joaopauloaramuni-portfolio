# Copie este arquivo para .env.local:  cp .env.example .env.local
# Todas as variáveis são opcionais: sem elas o site abre normalmente.

# Opcionais: só para testar o comando "guestbook"
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcionais: só para testar o comando "contato"
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_FOR_ME=
VITE_EMAILJS_TEMPLATE_ID_FOR_SENDER=
VITE_EMAILJS_PUBLIC_KEY=

# Opcional: token da GitHub API para os comandos "github" e "stats".
# No "stats", o token soma as linguagens por bytes de código (GraphQL) e fica de
# reserva quando o limite por IP do visitante (60 chamadas/hora) acaba.
# Use um token fine-grained, só com leitura de repositórios públicos.
# Sem VITE_ na frente, de propósito: ele fica só no servidor, no proxy
# /api/github (Vercel Function api/github.js; no npm run dev, o vite.config.js),
# e nunca vai para o build. Na Vercel, crie a mesma variável no projeto.
GITHUB_SITE_TOKEN=

# Opcional: só para o "npm run turmas", que roda na sua máquina e lê os
# repositórios privados dos grupos (ver scripts/turmas.mjs). Sem VITE_ na
# frente, de propósito: este token não pode ir para o build do site.
# Não use o GITHUB_SITE_TOKEN aqui: ele só lê repositórios públicos.
# Sem ele, o script tenta o `gh auth token` do GitHub CLI.
GITHUB_TOKEN=
